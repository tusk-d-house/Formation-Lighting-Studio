{
  "name": "formation-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "Dance & Performance Formation and Stage Lighting Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
